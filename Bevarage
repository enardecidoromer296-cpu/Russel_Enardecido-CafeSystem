/**
 * Represents a rice meal with optional upsizing and extra sides.
 * @author Romer Enardecido
 * @version 1.0
 */
public class Meal extends MenuItem {
    private boolean upsized;
    private int extraSides;

    /** Creates a regular meal with no extra sides. */
    public Meal() {
        super();
        upsized = false;
        extraSides = 0;
    }

    /**
     * Creates a meal with the supplied details.
     * @param name meal name
     * @param basePrice meal base price
     * @param itemCode meal code
     * @param upsized whether the meal is upsized
     * @param extraSides number of extra sides
     */
    public Meal(String name, double basePrice, String itemCode,
                boolean upsized, int extraSides) {
        super(name, basePrice, itemCode);
        this.upsized = upsized;
        this.extraSides = 0;
        setExtraSides(extraSides);
    }

    /**
     * Computes the meal price including upgrades and extra sides.
     * @return final meal price
     */
    @Override
    public double computePrice() {
        double price = basePrice;
        // Upsizing adds 20 pesos.
        if (upsized) {
            price += 20;
        }
        return price + (12 * extraSides);
    }

    /**
     * Returns the meal description including its options.
     * @return meal description
     */
    @Override
    public String getDescription() {
        String sizeStatus = upsized ? "Upsized" : "Regular";
        String sideLabel = extraSides == 1 ? "side" : "sides";
        return super.getDescription() + " " + sizeStatus + ", "
                + extraSides + " " + sideLabel;
    }

    /** @return true when the meal is upsized */
    public boolean isUpsized() { return upsized; }

    /**
     * Changes the meal's upsize status.
     * @param upsized new upsize status
     */
    public void setUpsized(boolean upsized) { this.upsized = upsized; }

    /** @return number of extra sides */
    public int getExtraSides() { return extraSides; }

    /**
     * Sets the number of extra sides; negative values are rejected.
     * @param extraSides requested number of extra sides
     */
    public void setExtraSides(int extraSides) {
        // Extra sides cannot be negative.
        if (extraSides < 0) {
            System.out.println("Error: extra sides cannot be negative.");
        } else {
            this.extraSides = extraSides;
        }
    }
}

/**
 * Abstract parent class for all campus cafe menu items.
 * @author Romer Enardecido
 * @version 1.0
 */
public abstract class MenuItem {
    protected String name;
    protected double basePrice;
    private String itemCode;

    /** Creates an unnamed menu item with a zero price and N/A code. */
    public MenuItem() {
        name = "Unnamed Item";
        basePrice = 0.0;
        itemCode = "N/A";
    }

    /**
     * Creates a menu item with the supplied details.
     * @param name item name
     * @param basePrice item base price
     * @param itemCode item code
     */
    public MenuItem(String name, double basePrice, String itemCode) {
        this();
        setName(name);
        setBasePrice(basePrice);
        setItemCode(itemCode);
    }

    /**
     * Computes the final price for a particular menu item.
     * @return computed item price
     */
    public abstract double computePrice();

    /**
     * Returns the item's basic description.
     * @return item name and code
     */
    public String getDescription() {
        return name + " [" + itemCode + "]";
    }

    /** @return the item name */
    public String getName() { return name; }

    /**
     * Updates the item name when the supplied value is valid.
     * @param name new item name
     */
    public void setName(String name) {
        if (name != null && !name.trim().isEmpty()) this.name = name;
    }

    /** @return the item's base price */
    public double getBasePrice() { return basePrice; }

    /**
     * Updates the base price; negative values are rejected.
     * @param basePrice new base price
     */
    public void setBasePrice(double basePrice) {
        // Reject a negative price and preserve the previous valid value.
        if (basePrice < 0) {
            System.out.println("Error: base price cannot be negative.");
        } else {
            this.basePrice = basePrice;
        }
    }

    /** @return the item's code */
    public String getItemCode() { return itemCode; }

    /**
     * Updates the item code when it is not blank.
     * @param itemCode new item code
     */
    public void setItemCode(String itemCode) {
        if (itemCode != null && !itemCode.trim().isEmpty()) this.itemCode = itemCode;
    }
}

/**
 * Represents an order containing up to three menu items for one customer.
 * @author Romer Enardecido
 * @version 1.0
 */
public class Order {
    private Customer customer;
    private MenuItem item1;
    private MenuItem item2;
    private MenuItem item3;
    private int itemCount;
    private String orderId;
    private double appliedVoucher;

    /**
     * Creates an order for a customer.
     * @param orderId order identification
     * @param customer customer placing the order
     */
    public Order(String orderId, Customer customer) {
        this.orderId = orderId;
        this.customer = customer;
        item1 = null;
        item2 = null;
        item3 = null;
        itemCount = 0;
        appliedVoucher = 0.0;
    }

    /**
     * Adds a menu item to the first empty slot.
     * @param item menu item to add
     * @return true if added; otherwise false
     */
    public boolean addItem(MenuItem item) {
        if (item == null) {
            System.out.println("Invalid menu item.");
            return false;
        } else if (item1 == null) {
            item1 = item;
            itemCount++;
            return true;
        } else if (item2 == null) {
            item2 = item;
            itemCount++;
            return true;
        } else if (item3 == null) {
            item3 = item;
            itemCount++;
            return true;
        } else {
            System.out.println("Order is full. Cannot add "
                    + item.getName() + ".");
            return false;
        }
    }

    /**
     * Calculates the sum of all item prices.
     * @return order subtotal
     */
    public double computeSubtotal() {
        double subtotal = 0.0;
        // Each object uses its own overridden computePrice method.
        if (item1 != null) subtotal += item1.computePrice();
        if (item2 != null) subtotal += item2.computePrice();
        if (item3 != null) subtotal += item3.computePrice();
        return subtotal;
    }

    /**
     * Calculates the total after a student discount, if applicable.
     * @return total after discount
     */
    public double computeTotal() {
        appliedVoucher = 0.0;
        double subtotal = computeSubtotal();
        // Students receive a 10 percent discount.
        if (customer.isStudent()) {
            return subtotal - (subtotal * 0.10);
        } else {
            return subtotal;
        }
    }

    /**
     * Calculates the discounted total after subtracting a voucher.
     * @param voucher voucher amount in pesos
     * @return final total, never below zero
     */
    public double computeTotal(double voucher) {
        double total = computeTotal();
        // Negative voucher values are not accepted.
        if (voucher < 0) {
            appliedVoucher = 0.0;
        } else {
            appliedVoucher = voucher;
        }
        total -= appliedVoucher;
        // A voucher cannot make the order total negative.
        if (total < 0) total = 0.0;
        return total;
    }

    /**
     * Prints the receipt and updates the customer's loyalty points.
     */
    public void printReceipt() {
        double subtotal = computeSubtotal();
        double discount = customer.isStudent() ? subtotal * 0.10 : 0.0;
        double total = subtotal - discount - appliedVoucher;
        if (total < 0) total = 0.0;

        String studentLabel = customer.isStudent() ? " (Student)" : "";
        System.out.println("\\nOrder #" + orderId + " — "
                + customer.getName() + studentLabel);
        printItem(item1);
        printItem(item2);
        printItem(item3);
        System.out.printf("Subtotal: %.2f%n", subtotal);

        if (customer.isStudent()) {
            System.out.printf("Student discount (10%%): -%.2f%n", discount);
        }
        if (appliedVoucher > 0) {
            System.out.printf("Voucher: -%.2f%n", appliedVoucher);
        }
        System.out.printf("TOTAL: %.2f%n", total);

        // Loyalty points are awarded from the final amount paid.
        customer.addPoints(total);
        System.out.println("Loyalty points: " + customer.getLoyaltyPoints());
    }

    /**
     * Prints one item and its computed price.
     * @param item item to print
     */
    private void printItem(MenuItem item) {
        if (item != null) {
            System.out.printf("%-43s %.2f%n",
                    item.getDescription(), item.computePrice());
        }
    }
}

/**
 * Represents a baked item that may be warmed for an extra fee.
 * @author Romer Enardecido
 * @version 1.0
 */
public class Pastry extends MenuItem {
    private boolean warmed;

    /** Creates a pastry with default menu-item values that is not warmed. */
    public Pastry() {
        super();
        warmed = false;
    }

    /**
     * Creates a pastry with the supplied details.
     * @param name pastry name
     * @param basePrice pastry base price
     * @param itemCode pastry code
     * @param warmed whether the pastry is warmed
     */
    public Pastry(String name, double basePrice, String itemCode, boolean warmed) {
        super(name, basePrice, itemCode);
        this.warmed = warmed;
    }

    /**
     * Computes the pastry price, including the warming fee when applicable.
     * @return final pastry price
     */
    @Override
    public double computePrice() {
        // Warming adds 10 pesos to the pastry price.
        if (warmed) {
            return basePrice + 10;
        }
        return basePrice;
    }

    /**
     * Returns the pastry description and warming status.
     * @return pastry description
     */
    @Override
    public String getDescription() {
        if (warmed) {
            return super.getDescription() + " (Warmed)";
        }
        return super.getDescription();
    }

    /** @return true when the pastry is warmed */
    public boolean isWarmed() { return warmed; }

    /**
     * Changes the pastry's warming status.
     * @param warmed new warming status
     */
    public void setWarmed(boolean warmed) { this.warmed = warmed; }
}

