/**
 * Represents a beverage whose price depends on its size.
 * @author Romer Enardecido
 * @version 1.0
 */
public class Beverage extends MenuItem {
    private String size;

    /** Creates a small beverage with default menu-item values. */
    public Beverage() {
        super();
        size = "S";
    }

    /**
     * Creates a beverage with the supplied details.
     * @param name beverage name
     * @param basePrice beverage base price
     * @param itemCode beverage code
     * @param size beverage size: S, M, or L
     */
    public Beverage(String name, double basePrice, String itemCode, String size) {
        super(name, basePrice, itemCode);
        this.size = "S";
        setSize(size);
    }

    /**
     * Computes the price based on beverage size.
     * @return final beverage price
     */
    @Override
    public double computePrice() {
        // Large beverages add 25 pesos to the base price.
        if (size.equals("L")) {
            return basePrice + 25;
        // Medium beverages add 15 pesos to the base price.
        } else if (size.equals("M")) {
            return basePrice + 15;
        } else {
            return basePrice;
        }
    }

    /**
     * Returns the beverage description including its size.
     * @return beverage description
     */
    @Override
    public String getDescription() {
        return super.getDescription() + " Size: " + size;
    }

    /** @return the beverage size */
    public String getSize() { return size; }

    /**
     * Sets the size only when it is S, M, or L.
     * @param size requested beverage size
     */
    public void setSize(String size) {
        if ("S".equals(size) || "M".equals(size) || "L".equals(size)) {
            this.size = size;
        }
    }
}

/**
 * Runs the Campus Cafe Ordering System demonstration.
 * @author Romer Enardecido
 * @version 1.0
 */
public class CafeApp {
    /**
     * Creates sample customers, menu items, orders, and receipts.
     * @param args command-line arguments
     */
    public static void main(String[] args) {
        // Create customers using different overloaded constructors.
        Customer customer1 = new Customer("Ana Reyes", true);
        Customer customer2 = new Customer("Ben Cruz");

        // Create a beverage, pastry, and meal using parameterized constructors.
        Beverage latte = new Beverage("Iced Latte", 95.00, "B-01", "L");
        Pastry ensaymada = new Pastry("Ensaymada", 45.00, "P-01", true);
        Meal adobo = new Meal("Chicken Adobo", 110.00, "M-01", true, 1);

        // Create default pastry and meal objects, then configure them with setters.
        Pastry cookie = new Pastry();
        cookie.setName("Cookie");
        cookie.setBasePrice(30.00);
        cookie.setItemCode("P-02");

        Meal defaultMeal = new Meal();
        defaultMeal.setName("Rice Meal");
        defaultMeal.setBasePrice(100.00);
        defaultMeal.setItemCode("M-03");

        // Create the first order and demonstrate the three-item limit.
        Order order1 = new Order("1001", customer1);
        order1.addItem(latte);
        order1.addItem(ensaymada);
        order1.addItem(adobo);
        order1.addItem(cookie);

        // Demonstrate rejection of invalid data without changing the valid price.
        latte.setBasePrice(-5);
        order1.printReceipt();

        // Create a default beverage and fill it using setters.
        Beverage hotChocolate = new Beverage();
        hotChocolate.setName("Hot Chocolate");
        hotChocolate.setBasePrice(-5);
        hotChocolate.setBasePrice(80.00);
        hotChocolate.setItemCode("B-02");
        hotChocolate.setSize("M");

        // Create the second meal with a parameterized constructor.
        Meal beefTapa = new Meal("Beef Tapa", 130.00, "M-02", false, 0);

        // Create the second order, apply a voucher, and print its receipt.
        Order order2 = new Order("1002", customer2);
        order2.addItem(hotChocolate);
        order2.addItem(beefTapa);
        order2.computeTotal(20.00);
        order2.printReceipt();
    }
}

/**
 * Represents a customer who can earn loyalty points.
 * @author Romer Enardecido
 * @version 1.0
 */
public class Customer {
    private String name;
    private boolean student;
    private int loyaltyPoints;

    /** Creates a non-student customer with a default name. */
    public Customer() {
        this("Unknown Customer", false);
    }

    /**
     * Creates a non-student customer with the supplied name.
     * @param name customer name
     */
    public Customer(String name) {
        this(name, false);
    }

    /**
     * Creates a customer with a name and student status.
     * @param name customer name
     * @param student true when the customer is a student
     */
    public Customer(String name, boolean student) {
        setName(name);
        this.student = student;
        loyaltyPoints = 0;
    }

    /**
     * Adds a specified number of loyalty points.
     * @param points points to add
     */
    public void addPoints(int points) {
        if (points > 0) loyaltyPoints += points;
    }

    /**
     * Adds one point for every 50 pesos spent.
     * @param amountSpent amount paid in pesos
     */
    public void addPoints(double amountSpent) {
        if (amountSpent > 0) loyaltyPoints += (int) (amountSpent / 50);
    }

    /** @return customer name */
    public String getName() { return name; }

    /**
     * Updates the customer name when it is not blank.
     * @param name new customer name
     */
    public void setName(String name) {
        if (name != null && !name.trim().isEmpty()) this.name = name;
    }

    /** @return true when the customer is a student */
    public boolean isStudent() { return student; }

    /**
     * Updates the customer's student status.
     * @param student new student status
     */
    public void setStudent(boolean student) { this.student = student; }

    /** @return current loyalty points */
    public int getLoyaltyPoints() { return loyaltyPoints; }

    /**
     * Sets loyalty points when the value is not negative.
     * @param loyaltyPoints new loyalty-point balance
     */
    public void setLoyaltyPoints(int loyaltyPoints) {
        if (loyaltyPoints >= 0) this.loyaltyPoints = loyaltyPoints;
    }
}

